#!/bin/sh
set -eu

if [ "${DISABLE_DESIGN_HOOK:-}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mkdir -p design/reports
python agents/pipeline.py --root "$repo_root" --changed-in-last-commit >> design/reports/post-commit.log 2>&1 || {
  echo "Design synchronization failed. See design/reports/post-commit.log" >&2
  exit 1
}
