<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmi:version="2.1">
  <uml:Model xmi:id="model_voltage_fail" name="VoltageFail_SW_Design">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_voltage_fail" name="VoltageFail">
      <ownedComment xmi:id="comment_pkg_voltage_fail">
        <body>Voltage Fail SW design generated from src/voltage_fail.c and inc/voltage_fail.h.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Enumeration" xmi:id="enum_output_signal" name="VoltageFail_OutputSignalType">
        <ownedLiteral xmi:id="enum_lit_off" name="VOLTAGE_FAIL_OUTPUT_OFF"/>
        <ownedLiteral xmi:id="enum_lit_low" name="VOLTAGE_FAIL_OUTPUT_LOW_VOLTAGE"/>
        <ownedLiteral xmi:id="enum_lit_over" name="VOLTAGE_FAIL_OUTPUT_OVER_VOLTAGE"/>
        <ownedLiteral xmi:id="enum_lit_invalid" name="VOLTAGE_FAIL_OUTPUT_INVALID_CONFIG"/>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_params" name="VoltageFail_ParamsType">
        <ownedAttribute xmi:id="attr_param_high_det" name="Par_HighVoltageDetection"/>
        <ownedAttribute xmi:id="attr_param_high_filter" name="Par_HighVoltageFailFiltering"/>
        <ownedAttribute xmi:id="attr_param_low_det" name="Par_LowVoltageDetection"/>
        <ownedAttribute xmi:id="attr_param_low_filter" name="Par_LowVoltageFailFiltering"/>
        <ownedAttribute xmi:id="attr_param_high_return" name="Par_HighVoltageReturn"/>
        <ownedAttribute xmi:id="attr_param_low_return" name="Par_LowVoltageReturn"/>
        <ownedAttribute xmi:id="attr_param_exhibition_low_return" name="Par_ExhibitionLowVoltageReturn"/>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_input" name="VoltageFail_InputType">
        <ownedAttribute xmi:id="attr_input_vbat" name="Input_H_VBAT"/>
        <ownedAttribute xmi:id="attr_input_ign1" name="Input_H_IGN1"/>
        <ownedAttribute xmi:id="attr_input_factory" name="Input_C_FactoryMode"/>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_state" name="VoltageFail_StateType">
        <ownedAttribute xmi:id="attr_state_high_vbat" name="m_VoltageHighFail"/>
        <ownedAttribute xmi:id="attr_state_high_ign1" name="m_VoltageHighFail_IGN1"/>
        <ownedAttribute xmi:id="attr_state_low_vbat" name="m_VoltageLowFail"/>
        <ownedAttribute xmi:id="attr_state_low_ign1" name="m_VoltageLowFail_IGN1"/>
        <ownedAttribute xmi:id="attr_state_high_vbat_time" name="highVbatFilterTimeMs"/>
        <ownedAttribute xmi:id="attr_state_high_ign1_time" name="highIgn1FilterTimeMs"/>
        <ownedAttribute xmi:id="attr_state_low_vbat_time" name="lowVbatFilterTimeMs"/>
        <ownedAttribute xmi:id="attr_state_low_ign1_time" name="lowIgn1FilterTimeMs"/>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_output" name="VoltageFail_OutputType">
        <ownedAttribute xmi:id="attr_output_high_vbat" name="m_VoltageHighFail"/>
        <ownedAttribute xmi:id="attr_output_high_ign1" name="m_VoltageHighFail_IGN1"/>
        <ownedAttribute xmi:id="attr_output_low_vbat" name="m_VoltageLowFail"/>
        <ownedAttribute xmi:id="attr_output_low_ign1" name="m_VoltageLowFail_IGN1"/>
        <ownedAttribute xmi:id="attr_output_voltage_fail" name="Output_INT_VoltageFail"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Component" xmi:id="cmp_voltage_fail" name="VoltageFail Component">
        <ownedComment xmi:id="comment_cmp_voltage_fail">
          <body>Embedded C component that detects VBAT/IGN1 high voltage and low voltage failure states with filtering and hysteresis return thresholds.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_voltage_fail" name="VoltageFail">
        <ownedOperation xmi:id="op_init" name="VoltageFail_Init">
          <ownedComment xmi:id="comment_op_init">
            <body>Initializes fail latch states and filter timers to Off/0.</body>
          </ownedComment>
          <ownedParameter xmi:id="param_init_state" name="state" direction="inout"/>
        </ownedOperation>
        <ownedOperation xmi:id="op_update" name="VoltageFail_Update">
          <ownedComment xmi:id="comment_op_update">
            <body>Updates high/low voltage fail latches and Output_INT_VoltageFail from input, parameters, and elapsed time.</body>
          </ownedComment>
          <ownedParameter xmi:id="param_update_state" name="state" direction="inout"/>
          <ownedParameter xmi:id="param_update_params" name="params" direction="in"/>
          <ownedParameter xmi:id="param_update_input" name="input" direction="in"/>
          <ownedParameter xmi:id="param_update_elapsed" name="elapsedMs" direction="in"/>
          <ownedParameter xmi:id="param_update_output" name="output" direction="out"/>
        </ownedOperation>
        <ownedOperation xmi:id="op_add_saturated" name="VoltageFail_AddSaturated" visibility="private">
          <ownedComment xmi:id="comment_op_add_saturated">
            <body>Performs uint32 saturated addition for filter timer accumulation.</body>
          </ownedComment>
        </ownedOperation>
        <ownedOperation xmi:id="op_update_filter" name="VoltageFail_UpdateFilter" visibility="private">
          <ownedComment xmi:id="comment_op_update_filter">
            <body>Accumulates hold time while condition is true and latches fail flag when filter time is reached.</body>
          </ownedComment>
        </ownedOperation>
        <ownedOperation xmi:id="op_get_output" name="VoltageFail_GetOutput" visibility="private">
          <ownedComment xmi:id="comment_op_get_output">
            <body>Maps high/low fail latch combination to Output_INT_VoltageFail.</body>
          </ownedComment>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_requirements" name="Requirements">
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_001" name="VF-R-001 High VBAT Fail Detection">
          <ownedComment xmi:id="comment_req_vf_001">
            <body>If Input_H_VBAT &gt;= Par_HighVoltageDetection is maintained for Par_HighVoltageFailFiltering or longer, m_VoltageHighFail shall be stored as On.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_002" name="VF-R-002 High IGN1 Fail Detection">
          <ownedComment xmi:id="comment_req_vf_002">
            <body>If Input_H_IGN1 &gt;= Par_HighVoltageDetection is maintained for Par_HighVoltageFailFiltering or longer, m_VoltageHighFail_IGN1 shall be stored as On.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_003" name="VF-R-003 Low VBAT Fail Detection">
          <ownedComment xmi:id="comment_req_vf_003">
            <body>If Input_H_VBAT &lt;= Par_LowVoltageDetection is maintained for Par_LowVoltageFailFiltering or longer, m_VoltageLowFail shall be stored as On.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_004" name="VF-R-004 Low IGN1 Fail Detection">
          <ownedComment xmi:id="comment_req_vf_004">
            <body>If Input_H_IGN1 &lt;= Par_LowVoltageDetection is maintained for Par_LowVoltageFailFiltering or longer, m_VoltageLowFail_IGN1 shall be stored as On.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_005" name="VF-R-005 High VBAT Fail Return">
          <ownedComment xmi:id="comment_req_vf_005">
            <body>If m_VoltageHighFail is On and Input_H_VBAT &lt;= Par_HighVoltageReturn, m_VoltageHighFail shall be stored as Off.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_006" name="VF-R-006 High IGN1 Fail Return">
          <ownedComment xmi:id="comment_req_vf_006">
            <body>If m_VoltageHighFail_IGN1 is On and Input_H_IGN1 &lt;= Par_HighVoltageReturn, m_VoltageHighFail_IGN1 shall be stored as Off.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_007" name="VF-R-007 Low VBAT Fail Return">
          <ownedComment xmi:id="comment_req_vf_007">
            <body>If m_VoltageLowFail is On, return threshold is Par_LowVoltageReturn in Custom Mode and Par_ExhibitionLowVoltageReturn otherwise. If Input_H_VBAT &gt;= selected threshold, m_VoltageLowFail shall be stored as Off.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_008" name="VF-R-008 Low IGN1 Fail Return">
          <ownedComment xmi:id="comment_req_vf_008">
            <body>If m_VoltageLowFail_IGN1 is On, return threshold is Par_LowVoltageReturn in Custom Mode and Par_ExhibitionLowVoltageReturn otherwise. If Input_H_IGN1 &gt;= selected threshold, m_VoltageLowFail_IGN1 shall be stored as Off.</body>
          </ownedComment>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="req_vf_009" name="VF-R-009 Integrated Voltage Fail Output">
          <ownedComment xmi:id="comment_req_vf_009">
            <body>Output_INT_VoltageFail shall be Off, LowVoltage, OverVoltage, or InvalidConfig according to m_VoltageHighFail, m_VoltageHighFail_IGN1, m_VoltageLowFail, and m_VoltageLowFail_IGN1.</body>
          </ownedComment>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="act_voltage_fail_update" name="VoltageFail_Update Activity">
        <ownedComment xmi:id="comment_act_voltage_fail_update">
          <body>Flow: validate pointers, update high/low filters, apply high return hysteresis, select low return threshold by Factory Mode, apply low return hysteresis, copy latch states to output, calculate Output_INT_VoltageFail.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:StateMachine" xmi:id="sm_fail_latch" name="Voltage Fail Latch State Machine">
        <ownedComment xmi:id="comment_sm_fail_latch">
          <body>Each individual fail latch has two logical states: Off and On. Detection filter transition sets Off to On. Return threshold transition resets On to Off.</body>
        </ownedComment>
        <region xmi:id="sm_fail_latch_region" name="FailLatchRegion">
          <subvertex xmi:type="uml:State" xmi:id="state_fail_off" name="Off"/>
          <subvertex xmi:type="uml:State" xmi:id="state_fail_on" name="On"/>
          <transition xmi:id="trans_detect_fail" name="DetectionFilterReached" source="state_fail_off" target="state_fail_on"/>
          <transition xmi:id="trans_return_fail" name="ReturnThresholdReached" source="state_fail_on" target="state_fail_off"/>
        </region>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_output_decision_table" name="Output_INT_VoltageFail Decision Table">
        <ownedComment xmi:id="comment_output_decision_table">
          <body>Priority 1: same channel High and Low both On =&gt; INVALID_CONFIG. Priority 2: any High Fail On =&gt; OVER_VOLTAGE. Priority 3: VBAT Low and IGN1 Low both On =&gt; LOW_VOLTAGE. Priority 4: otherwise =&gt; OFF.</body>
        </ownedComment>
      </packagedElement>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
